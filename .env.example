# Telegram (server-only; never expose the bot token to the browser)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Supabase (service role is server-only; never use it in NEXT_PUBLIC_* variables)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Credential vault (server-only AES-256-GCM key; base64-encoded 32 bytes)
CREDENTIAL_VAULT_KEY=
CREDENTIAL_VAULT_KEY_VERSION=v1

# Production trading policy. Keep false until exchange connections are validated.
LIVE_TRADING_ENABLED=false

# CoinMarketCap API (server-only)
MARKET_DATA_API_KEY=

# Runtime
NODE_ENV=production
PORT=3000
AUTOMATION_INTERVAL_MS=30000
