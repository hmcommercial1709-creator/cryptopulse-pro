  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "5.8.2",
    "@opennextjs/cloudflare": "1.20.6",
    "wrangler": "4.134.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
